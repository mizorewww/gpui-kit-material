    {
      "id": "button",
      "reference": "https://md3.io/components/button/",
      "status": "unreviewed",
      "cases": [],
      "reviews": [],
      "evidence": [
        {
          "kind": "browser-color-transitions",
          "path": "conformance/reference/button-effects.json",
          "scope": "Pinned source CSS in recorded Chromium: Filled to Tonal and enabled to disabled at 125ms, first disabled reversal at 25ms. Color samples only; no state-layer, shadow, ripple, repeated-reversal or reduced-motion conformance."
        },
        {
          "kind": "native-render-tests",
          "path": "crates/material/src/components/button.rs",
          "scope": "GPUI fake-clock color transitions and concurrent theme changes, press radius, icon slot geometry, focus and activation regressions. Does not establish desktop/browser pixel equality or full component conformance."
        },
        {
          "kind": "browser-state-transitions",
          "path": "conformance/reference/button-states.json",
          "scope": "Real pointer hover/press, keyboard focus and disabled exit. State-layer opacity sampled at 50ms of 100ms; shadows separately sampled at 125ms of 250ms. Independent channel samples, not simultaneous screenshot frames or ripple evidence."
        },
        {
          "kind": "browser-reduced-motion-transitions",
          "path": "conformance/reference/button-states-reduced-motion.json",
          "scope": "Same state cases with prefers-reduced-motion verified active. Confirms retained opacity and shadow transitions; does not establish spatial, ripple or whole-component reduced-motion conformance."
        },
        {
          "kind": "browser-ripple-lifecycle",
          "path": "conformance/reference/button-ripple.json",
          "scope": "Actual pinned createButton/createRipple and full stylesheet: exact expansion and fade samples, release cleanup, border offsets, paint order, pointer routing, static reduced motion and dynamic media switching. Existing ordinary fades continue through preference changes; reduced-mode releases finish immediately. Does not establish whole-component desktop/browser pixel conformance."
        },
        {
          "kind": "browser-loading-layout-and-circular-motion",
          "path": "conformance/reference/button-loading.json",
          "scope": "Pinned createButton and full stylesheet, ordinary/reduced modes, five variants and sizes, no/leading/trailing icon; progress-only, loading, repeated loading and restore. Includes exact circular motion samples. Establishes reference behavior, not implementation pixel equality or full component conformance."
        },
        {
          "kind": "browser-circular-geometry-and-cascade",
          "path": "conformance/reference/button-circular.json",
          "scope": "Pinned createButton and full stylesheet: 666 settled computed snapshots in light/ordinary motion, covering real pointer active states, circular modifier specificity, five sizes, two shapes, five variants, three content arrangements and loading. Independent recapture produced identical parsed JSON. Reference evidence only; circular implementation, raster and intermediate motion remain pending."
        },
        {
          "kind": "browser-controlled-active-states",
          "path": "conformance/reference/button-active.json",
          "scope": "Actual pinned setActive API and full stylesheet: 300 combinations of variant, size, shape, ripple and plain/unselected/selected toggle, each at five settled active/disabled/restored states. Controlled active retains pressed shape while disabled and pressed opacity without ripple. No synthetic pointer, selection or wave is created. Excludes circular and intermediate browser motion."
        }
      ],
