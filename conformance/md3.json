      "icon",
      "elevation",
      "state-layer"
    ],
    "motion": [
      "duration",
      "easing-or-spring",
      "delay",
      "overshoot",
      "shape-morph",
      "interruption",
      "retargeting",
      "reduced-motion"
    ],
    "review_required": [
      "implementation-commit",
      "reference-version",
      "reference-and-implementation-viewport",
      "font-and-scale",
      "coverage-cases",
      "desktop-and-browser-screenshots",
      "timed-frames-or-video",
      "test-results",
      "independent-subagent-verdict",
      "os-and-browser-version",
      "device-pixel-ratio",
      "zoom"
    ],
    "completion": "Every applicable case has evidence and an independent PASS tied to the delivered implementation. Unspecified, untested, and unreviewed cases remain incomplete. The entire gallery CPU frame must additionally satisfy the performance gate for every component acceptance.",
    "themes": "light and dark, every built-in palette, and reference baseline",
    "review_invalidation": "Any implementation change invalidates affected prior PASS verdicts until independently reviewed again.",
    "performance": {
      "status": "failed: measured native startup scopes exceed 2ms; other scenarios and WASM timing remain unverified",
      "scope": "entire gallery frame, on both desktop and wasm-browser; applies to acceptance of every component",
      "metric": "CPU frame elapsed time including view rendering, layout, prepaint, paint, scene finalization and graphics command submission",
      "threshold_ms": 2.0,
      "comparison": "less than or equal to; any measured frame > 2.0 ms fails",
      "aggregation": "maximum per-frame duration; also report median, p95, p99 and over-budget count",
      "first_frame": "included; report cold-start and steady-state separately without excluding slow frames from acceptance",
      "gpu": "measure and report separately; never substitute GPU or average FPS for CPU frame time",
      "evidence_required": [
        "exact source commit and dirty-worktree status",
        "release build profile and build flags",
        "hardware, OS, browser and graphics backend",
        "viewport, device pixel ratio, zoom, theme and text scale",
        "scenario and interaction schedule",
        "per-frame raw timings and timing boundaries",
        "frame count, maximum and over-budget count",
        "independent subagent review"
      ],
      "scenarios": [
        "initial frame",
        "idle",
        "hover and keyboard focus",
        "press, release and toggle",
        "interrupted and retargeted animations",
        "loading and progress",
        "scrolling and chapter navigation",
        "theme and text-scale changes",
        "reduced-motion transitions"
      ],
      "completion": "No component or gallery can pass without whole-gallery evidence at or below the budget. Existing functional or visual reviews do not establish performance acceptance.",
      "evidence": "conformance/performance/startup-visibility-comparison.json"
    },
    "reference_precedence": "Use reference_policy for all visual, motion, theme, typography and state assertions. A secondary-reference PASS cannot establish primary-reference conformance."
  },
