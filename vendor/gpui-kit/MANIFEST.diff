--- Cargo.toml.orig
+++ Cargo.toml
@@ -10,13 +10,30 @@
 repository = "https://github.com/longbridge/gpui-kit"
 readme = "README.md"
 publish = true
-edition.workspace = true
+edition = "2024"
 
-[lints]
-workspace = true
+[lints.clippy]
+almost_complete_range = "allow"
+arc_with_non_send_sync = "allow"
+borrowed_box = "allow"
+dbg_macro = "deny"
+let_underscore_future = "allow"
+manual_is_multiple_of = "allow"
+map_entry = "allow"
+module_inception = "allow"
+non_canonical_partial_ord_impl = "allow"
+reversed_empty_ranges = "allow"
+single_range_in_vec_init = "allow"
+style = { level = "allow", priority = -1 }
+todo = "deny"
+type_complexity = "allow"
+useless_conversion = "allow"
 
 [features]
 default = ["component", "assets"]
+# Explicit opt-in; default WASM builds use the single-threaded platform.
+# This restores upstream worker/atomics support and its toolchain/runtime requirements.
+multithreaded-web = ["gpui_platform/multithreaded", "gpui_web/multithreaded", "gpui-fast-platform?/multithreaded", "gpui-fast-web?/multithreaded"]
 # Select GPUI Fast across the core, platforms, and already-enabled layers.
 gpui-fast = ["dep:gpui-fast", "dep:gpui-fast-platform", "dep:gpui-fast-web", "gpui-base/gpui-fast", "gpui-component?/gpui-fast", "gpui-kit-assets?/gpui-fast"]
 # The styled component library, `gpui_kit::component`. Initializes `gpui-base` too.
@@ -76,26 +93,28 @@
 tree-sitter-zig = ["component", "gpui-component/tree-sitter-zig"]
 
 [dependencies]
-gpui_macros.workspace = true
-gpui.workspace = true
-gpui-fast = { workspace = true, optional = true }
-gpui-base.workspace = true
-gpui-component = { workspace = true, optional = true }
-gpui-kit-assets = { workspace = true, optional = true }
+gpui_macros = { package = "gpui-pre-macros", version = "=0.3.10" }
+gpui = { package = "gpui-pre", version = "=0.3.10" }
+gpui-fast = { package = "gpui-fast", version = "0.1.12", features = ["windows-manifest-provided-by-host"], optional = true }
+gpui-base = { version = "0.8.1", git = "https://github.com/longbridge/gpui-kit", rev = "bb85882e1faab845d9e7be33b69a152879a90f69" }
+gpui-component = { version = "0.8.1", git = "https://github.com/longbridge/gpui-kit", rev = "bb85882e1faab845d9e7be33b69a152879a90f69", optional = true }
+gpui-kit-assets = { version = "0.8.1", git = "https://github.com/longbridge/gpui-kit", rev = "bb85882e1faab845d9e7be33b69a152879a90f69", optional = true }
 
-[target.'cfg(not(any(target_os = "ios", target_os = "android")))'.dependencies]
-gpui_platform.workspace = true
-gpui-fast-platform = { workspace = true, optional = true }
+[target.'cfg(not(any(target_os = "ios", target_os = "android", target_family = "wasm")))'.dependencies]
+gpui_platform = { package = "gpui-pre-platform", version = "=0.3.10", features = ["font-kit", "x11", "wayland", "runtime_shaders"] }
+gpui-fast-platform = { package = "gpui-fast-platform", version = "0.1.12", features = ["font-kit", "x11", "wayland", "runtime_shaders"], optional = true }
 
 [target.'cfg(target_family = "wasm")'.dependencies]
-gpui_web.workspace = true
-gpui-fast-web = { workspace = true, optional = true }
+gpui_platform = { package = "gpui-pre-platform", version = "=0.3.10", features = ["font-kit", "x11", "wayland", "runtime_shaders"], default-features = false }
+gpui_web = { package = "gpui-pre-web", version = "=0.3.10", default-features = false }
+gpui-fast-platform = { package = "gpui-fast-platform", version = "0.1.12", features = ["font-kit", "x11", "wayland", "runtime_shaders"], default-features = false, optional = true }
+gpui-fast-web = { package = "gpui-fast-web", version = "0.1.12", default-features = false, optional = true }
 
 [dev-dependencies]
 chrono = "0.4.38"
-gpui = { workspace = true, features = ["test-support"] }
-gpui-fast = { workspace = true, features = ["test-support"] }
-lsp-types.workspace = true
+gpui = { package = "gpui-pre", version = "=0.3.10", features = ["test-support"] }
+gpui-fast = { package = "gpui-fast", version = "0.1.12", features = ["windows-manifest-provided-by-host", "test-support"] }
+lsp-types = { version = "0.97.0", features = ["proposed"] }
 
 [[test]]
 name = "ui"
