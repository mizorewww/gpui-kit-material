  ],
  "profiler_patches": [
    {
      "path": "src/profiler.rs",
      "scope": "CpuFrameTiming gains presentation_wait/presentation_waits; record_presentation_wait attributes platform-reported presentation API-call elapsed time (including internal work and scheduling, not only blocking) to the innermost open CPU frame scope while tracing. Scope boundaries and durations are unchanged."
    },
    {
      "path": "src/profiler.rs",
      "scope": "GpuExecution, record_gpu_execution and take_gpu_executions: a bounded (65536, overflow counted) thread-safe store of driver GPU timestamps recorded only while tracing; not cleared by trace toggles so late completions survive until taken."
    },
    {
      "path": "src/profiler.rs, src/profiler/journal.rs",
      "scope": "Atomic fetch_update renamed to try_update for the pinned toolchain's deprecation; identical semantics."
    },
    {
      "path": "src/window.rs, src/profiler.rs",
      "scope": "PresentTiming.successful_new_frame carries the existing distinct-draw successful-submission decision: true for a confirmed new generation, false for known failed or repeated submission, unknown when counters are unavailable or reset. Raw events preserve failed-attempt/retry outcomes independently of latency filtering and pending-draw consumption; present_end is CPU observation of submission, not GPU completion or scanout. Complete CPU scope timing and submission behavior are unchanged."
    }
  ],
